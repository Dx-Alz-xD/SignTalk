# SignTalk configuration.
#
# Copy to .env and fill in what you need. Every value here is optional: with an
# empty .env the API runs on SQLite, prints verification codes to the terminal
# instead of sending them, and skips the optional features.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# A variable already exported in your shell always wins over this file.


# ---------------------------------------------------------------- database --

# PostgreSQL. Leave unset and the backend probes localhost:5432, then falls
# back to SQLite at backend/data/signtalk.db.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/signtalk
# DATABASE_URL=sqlite:///backend/data/signtalk.db

# Force one engine. 'postgres' refuses the SQLite fallback, which is what a
# deployment wants: fail loudly rather than quietly write to a local file.
# SIGNTALK_DB=postgres


# ------------------------------------------------------------------ server --

# 'prod' puts the Secure flag on the session cookie. Leave unset on localhost,
# where there is no TLS to attach it to.
# SIGNTALK_ENV=prod

# Extra browser origins allowed to call the API, comma separated. The two local
# Next apps (3000 and 3001) are allowed by default.
# SIGNTALK_ORIGINS=https://signtalk.example.com


# -------------------------------------------------------- built-in datasets --

# Image datasets imported once at start-up as built-in sign languages, as
# "Name=path" pairs. The bundled ASL set and an ISL set at D:/dataset_ISL are
# the default. Needs: pip install mediapipe opencv-python
# SIGNTALK_DATASETS=ISL=D:/dataset_ISL;ASL=detector/asl_dataset

# Never import at start-up (run python -m backend.import_dataset by hand).
# SIGNTALK_AUTO_IMPORT=0

# Use at most this many images per symbol, for a quicker first run.
# SIGNTALK_IMPORT_LIMIT=40


# ----------------------------------------------------------- speech to text --

# Whisper model for the Video Translator: tiny | base | small | medium.
# Larger is more accurate and slower. Needs: pip install faster-whisper
# SIGNTALK_WHISPER_MODEL=base
# SIGNTALK_WHISPER_DEVICE=cpu


# ------------------------------------------------------ email and SMS codes --
# Without these, recovery codes are printed in the terminal instead of sent.
# python backend/check_delivery.py tests whatever you set.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=an-app-password-not-your-real-one
# SMTP_FROM=you@example.com

# SMS through Twilio...
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15017122661

# ...or Textbelt, which needs no account. 'textbelt' is one free text per day.
# TEXTBELT_KEY=textbelt

# Phone number on the seeded demo account, for an SMS demo.
# SIGNTALK_DEMO_PHONE=+919812345678


# ------------------------------------------------------------- web app --
# These belong in Frontend/UX/.env.local, not here: Next.js reads its own file
# and only NEXT_PUBLIC_* variables reach the browser.
#
#   NEXT_PUBLIC_SIGNTALK_API=http://localhost:8000
#   NEXT_PUBLIC_TRANSLATE_URL=http://localhost:5000/translate
#   NEXT_PUBLIC_SITE_URL=https://signtalk.example.com
