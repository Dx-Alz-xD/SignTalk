# ---------------------------------------------------------------- secrets --
# Database password, SMTP app password, Twilio token.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- runtime --
# SQLite database the backend falls back to when there is no PostgreSQL.
backend/data/

# ----------------------------------------------------------------- Python --
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------- Node --
# Each app also has its own .gitignore; these catch anything at the root.
node_modules/
.next/
*.tsbuildinfo
.pnpm-store/

# ------------------------------------------------------------------- logs --
*.log
npm-debug.log*
pnpm-debug.log*

# ----------------------------------------------------------------- editors --
.vscode/
.idea/
*.swp
.claude/
# Regenerated by `next dev` on every run; it only points at AGENTS.md, which
# is tracked. Ignored so it does not come back as a tracked file.
CLAUDE.md

# ---------------------------------------------------------------------- OS --
.DS_Store
Thumbs.db
desktop.ini
